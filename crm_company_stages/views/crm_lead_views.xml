<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_form_stage_company" model="ir.ui.view">
        <field name="name">crm.lead.form.stage.company</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Native view has an explicit team-only domain, so the model
                 field domain alone would NOT fix the statusbar. -->
            <xpath expr="//header/field[@name='stage_id']" position="before">
                <field name="company_id" invisible="1"/>
            </xpath>
            <xpath expr="//header/field[@name='stage_id']" position="attributes">
                <attribute name="domain">['&amp;', '|', ('company_id', '=', False), ('company_id', '=', company_id), '|', ('team_ids', '=', False), ('team_ids', 'in', team_id)]</attribute>
            </xpath>
        </field>
    </record>
    <record id="crm_lead_kanban_stage_company" model="ir.ui.view">
        <field name="name">crm.lead.kanban.stage.company</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban/field[@name='stage_id']" position="before">
                <field name="company_id"/>
            </xpath>
        </field>
    </record>
</odoo>
